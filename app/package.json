{
  "name": "wishlist-reconnection-prototype",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "test": "jest",
    "build:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "gates": "jest gates --runInBand --verbose",
    "shadow": "jest shadow.report --runInBand",
    "experiment": "jest experiment.report --runInBand",
    "panel": "jest panel.report --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "expo": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(?:jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)",
      "<rootDir>/gates/**/*.gate.test.ts",
      "<rootDir>/reports/**/*.report.test.ts"
    ],
    "globalSetup": "<rootDir>/gates/globalSetup.js",
    "globalTeardown": "<rootDir>/gates/globalTeardown.js"
  }
}